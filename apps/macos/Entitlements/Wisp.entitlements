<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Hardened runtime, not App Sandbox: Accessibility control, CGEventTap and cross-app automation
  are incompatible with the sandbox (DECISIONS.md D-013). Only the exceptions Wisp needs.
-->
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Reminders and Calendar (EventKit) under the hardened runtime. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
