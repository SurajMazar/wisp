# Copy to .env for local development. Never commit .env.
# API keys are NOT configured here — Wisp stores them in the macOS Keychain via Settings → AI Models.

# Load the React UI from the Vite dev server instead of the bundled assets.
WISP_DEV_URL=http://localhost:5173

# Override the data directory (defaults to ~/Library/Application Support/Wisp).
# WISP_DATA_DIR=/tmp/wisp-dev

# Ollama endpoint (default shown).
OLLAMA_HOST=http://127.0.0.1:11434

# Log level for wisp-core: error | warn | info | debug | trace
WISP_LOG=info
